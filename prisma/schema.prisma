// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

enum UserRole {
  ADMIN
  ORGANIZER
  MODERATOR
  PARTICIPANT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  avatar        String?
  role          UserRole @default(PARTICIPANT)
  points        Int      @default(0)
  level         Int      @default(1)
  bio           String?
  phone         String?
  country       String?
  language      String   @default("es")
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  attendances   Attendance[]
  votes         Vote[]
  notifications Notification[]
  achievements  UserAchievement[]
  qrCodes       QRCode[]
  certificates  Certificate[]
  createdEvents Event[]         @relation("EventCreator")
  sessions      Session[]
  registrations ActivityRegistration[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

// ==================== EVENTS ====================

model Event {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  logo            String?
  image           String?
  startDate       DateTime
  endDate         DateTime
  location        String?
  address         String?
  latitude        Float?
  longitude       Float?
  website         String?
  isActive        Boolean  @default(true)
  votingEnabled   Boolean  @default(true)
  qrEnabled       Boolean  @default(true)
  mapsEnabled     Boolean  @default(true)
  gamificationEnabled Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  creatorId       String
  creator         User     @relation("EventCreator", fields: [creatorId], references: [id])
  rooms           Room[]
  activities      Activity[]
  projects        Project[]
  speakers        Speaker[]
  votingConfigs   VotingConfig[]
  notifications   Notification[]
  notificationConfigs NotificationConfig[]
  
  @@map("events")
}

// ==================== ROOMS ====================

model Room {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  capacity    Int      @default(100)
  building    String?
  floor       String?
  latitude    Float?
  longitude   Float?
  color       String?  @default("#3B82F6")
  icon        String?  @default("map-pin")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activities  Activity[]
  projects    Project[]
  qrCodes     QRCode[]
  
  @@unique([eventId, name])
  @@map("rooms")
}

// ==================== SPEAKERS ====================

model Speaker {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  photo       String?
  bio         String?
  title       String?
  company     String?
  email       String?
  twitter     String?
  linkedin    String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  activities  Activity[]
  
  @@map("speakers")
}

// ==================== ACTIVITIES ====================

enum ActivityStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityType {
  KEYNOTE
  WORKSHOP
  PANEL
  PRESENTATION
  NETWORKING
  BREAK
  OTHER
}

model Activity {
  id          String         @id @default(cuid())
  eventId     String
  roomId      String
  speakerId   String?
  title       String
  description String?
  type        ActivityType   @default(PRESENTATION)
  status      ActivityStatus @default(SCHEDULED)
  theme       String?
  tags        String?        // JSON array of tags
  startTime   DateTime
  endTime     DateTime
  maxCapacity Int?
  currentAttendance Int @default(0)
  color       String?  @default("#10B981")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  speaker     Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  qrCodes     QRCode[]
  registrations ActivityRegistration[]

  @@map("activities")
}

// ==================== PROJECTS ====================

enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FINALIST
  WINNER
}

model Project {
  id           String        @id @default(cuid())
  eventId      String
  roomId       String?
  name         String
  team         String        // JSON array of team members
  category     String?
  description  String?
  image        String?
  videoUrl     String?
  githubUrl    String?
  websiteUrl   String?
  status       ProjectStatus @default(DRAFT)
  totalVotes   Int           @default(0)
  averageScore Float?
  rank         Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Relations
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room         Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  votes        Vote[]
  qrCodes      QRCode[]
  
  @@map("projects")
}

// ==================== VOTING ====================

enum VoteType {
  LIKE
  STARS
  POINTS
}

model VotingConfig {
  id            String    @id @default(cuid())
  eventId       String
  name          String
  voteType      VoteType  @default(STARS)
  maxVotesPerUser Int     @default(3)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean   @default(true)
  showResults   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@map("voting_configs")
}

model Vote {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  score       Int      @default(1)  // 1 for like, 1-5 for stars, 1-10 for points
  comment     String?
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([userId, projectId])
  @@map("votes")
}

// ==================== ATTENDANCE ====================

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  activityId  String
  checkInTime DateTime @default(now())
  checkOutTime DateTime?
  points      Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, activityId])
  @@map("attendances")
}

// ==================== ACTIVITY REGISTRATIONS ====================

model ActivityRegistration {
  id              String    @id @default(cuid())
  userId          String
  activityId      String
  reminderSet     Boolean   @default(false)
  reminderMinutes Int?
  registeredAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@map("activity_registrations")
}

// ==================== QR CODES ====================

enum QRType {
  ROOM
  ACTIVITY
  PROJECT
  USER
  EVENT
}

model QRCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        QRType
  userId      String?
  roomId      String?
  activityId  String?
  projectId   String?
  eventId     String?
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  scanCount   Int      @default(0)
  createdAt   DateTime @default(now())
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  activity    Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("qr_codes")
}

// ==================== NOTIFICATIONS ====================

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ACTIVITY_START
  ACTIVITY_REMINDER
  VOTE_REMINDER
  VOTE_CONFIRMATION
  ACHIEVEMENT
  ANNOUNCEMENT
  POINTS_EARNED
  CERTIFICATE_READY
}

model NotificationConfig {
  id                      String   @id @default(cuid())
  eventId                 String
  
  // Activity notifications
  activityStartEnabled    Boolean  @default(true)
  activityReminderEnabled Boolean  @default(true)
  activityReminderMinutes Int      @default(15)
  
  // Vote notifications
  voteConfirmationEnabled Boolean  @default(true)
  voteReminderEnabled     Boolean  @default(true)
  
  // Gamification notifications
  pointsEarnedEnabled     Boolean  @default(true)
  achievementEnabled      Boolean  @default(true)
  
  // Certificate notifications
  certificateReadyEnabled Boolean  @default(true)
  
  // Global announcements
  announcementsEnabled    Boolean  @default(true)
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Relations
  event                   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@map("notification_configs")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String?
  eventId     String?
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  isGlobal    Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  
  // Relations
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

// ==================== GAMIFICATION ====================

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  icon       String?
  points     Int      @default(0)
  category   String?
  requirement String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  
  userAchievements UserAchievement[]
  
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ==================== CERTIFICATES ====================

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  eventId     String?
  activityId  String?  // Activity for which the certificate was issued
  type        String   // attendance, speaker, organizer, winner
  title       String
  description String?
  issueDate   DateTime @default(now())
  pdfUrl      String?
  code        String   @unique
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("certificates")
}

model CertificateTemplate {
  id              String   @id @default(cuid())
  eventId         String?  // null for default template
  name            String
  type            String   @default("attendance") // attendance, speaker, winner, etc.
  
  // Header settings
  headerText      String?  @default("CERTIFICADO DE PARTICIPACIÓN")
  logoUrl         String?
  
  // Body settings  
  bodyText        String?  @default("Se certifica que")
  participantLabel String? @default("ha participado en")
  eventLabel      String?  @default("evento")
  
  // Footer settings
  organizationName String? @default("Fábrica de Ideas")
  organizationLogo String?
  signatureText   String?
  signatureImageUrl String?
  
  // Style settings
  backgroundColor String? @default("#ffffff")
  primaryColor    String? @default("#059669")  // emerald-600
  secondaryColor  String? @default("#0d9488")  // teal-600
  textColor       String? @default("#1f2937")  // gray-800
  fontFamily      String? @default("Helvetica")
  
  // Border settings
  borderColor     String? @default("#059669")
  borderWidth     Int?    @default(4)
  borderRadius    Int?    @default(0)
  
  // Paper settings
  paperWidth      Int?    @default(297)  // A4 landscape width in mm
  paperHeight     Int?    @default(210)  // A4 landscape height in mm
  
  // Content layout
  showQrCode      Boolean @default(true)
  showCode        Boolean @default(true)
  showDate        Boolean @default(true)
  showActivities  Boolean @default(true)  // Show list of attended activities
  
  // Status
  isActive        Boolean @default(true)
  isDefault       Boolean @default(false) // Mark as default template for type
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("certificate_templates")
}

// ==================== ANALYTICS ====================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // page_view, qr_scan, vote, attendance, etc.
  userId      String?
  eventId     String?
  entityId    String?
  entityType  String?
  metadata    String?  // JSON
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@map("analytics_events")
}
