generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  password             String
  name                 String
  avatar               String?
  role                 UserRole               @default("PARTICIPANT")
  points               Int                    @default(0)
  level                Int                    @default(1)
  bio                  String?
  phone                String?
  country              String?
  language             String                 @default("es")
  isActive             Boolean                @default(true)
  acceptedTerms        Boolean                @default(false)
  acceptedTermsAt      DateTime?
  lastLogin            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  registrations        ActivityRegistration[]
  attendances          Attendance[]
  certificates         Certificate[]
  evaluations          Evaluation[]
  evaluatorAssignments EvaluatorAssignment[]
  createdEvents        Event[]                @relation("EventCreator")
  notifications        Notification[]
  passwordResets       PasswordReset[]
  qrCodes              QRCode[]
  qrScans              QRScan[]
  sessions             Session[]
  achievements         UserAchievement[]
  votes                Vote[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Event {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  description         String?
  logo                String?
  image               String?
  startDate           DateTime
  endDate             DateTime
  location            String?
  address             String?
  latitude            Float?
  longitude           Float?
  website             String?
  isActive            Boolean              @default(true)
  votingEnabled       Boolean              @default(true)
  qrEnabled           Boolean              @default(true)
  mapsEnabled         Boolean              @default(true)
  gamificationEnabled Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  creatorId           String
  activities          Activity[]
  creator             User                 @relation("EventCreator", fields: [creatorId], references: [id])
  notificationConfigs NotificationConfig[]
  notifications       Notification[]
  projects            Project[]
  rooms               Room[]
  speakers            Speaker[]
  votingConfigs       VotingConfig[]

  @@map("events")
}

model Room {
  id          String     @id @default(cuid())
  eventId     String
  name        String
  description String?
  capacity    Int        @default(100)
  building    String?
  floor       String?
  latitude    Float?
  longitude   Float?
  color       String?    @default("#3B82F6")
  icon        String?    @default("map-pin")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  Activity[]
  projects    Project[]
  qrCodes     QRCode[]
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
  @@map("rooms")
}

model Speaker {
  id         String     @id @default(cuid())
  eventId    String
  name       String
  photo      String?
  bio        String?
  title      String?
  company    String?
  email      String?
  twitter    String?
  linkedin   String?
  website    String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("speakers")
}

model Activity {
  id                String                 @id @default(cuid())
  eventId           String
  roomId            String
  speakerId         String?
  title             String
  description       String?
  type              ActivityType           @default("PRESENTATION")
  status            ActivityStatus         @default("SCHEDULED")
  theme             String?
  tags              String?
  startTime         DateTime
  endTime           DateTime
  maxCapacity       Int?
  currentAttendance Int                    @default(0)
  color             String?                @default("#10B981")
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  expositorName     String?
  speaker           Speaker?               @relation(fields: [speakerId], references: [id])
  room              Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations     ActivityRegistration[]
  attendances       Attendance[]
  qrCodes           QRCode[]

  @@map("activities")
}

model Project {
  id                   String                @id @default(cuid())
  eventId              String
  roomId               String?
  name                 String
  team                 String
  category             String?
  description          String?
  image                String?
  videoUrl             String?
  githubUrl            String?
  websiteUrl           String?
  status               ProjectStatus         @default("DRAFT")
  totalVotes           Int                   @default(0)
  averageScore         Float?
  averageEvaluation    Float?                @default(0)
  evaluationCount      Int                   @default(0)
  rank                 Int?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  area                 String?
  course               String?
  institution          String?
  leaderEmail          String?
  leaderName           String?
  leaderPhone          String?
  projectCategory      String?
  tutorName            String?
  evaluations          Evaluation[]
  evaluatorAssignments EvaluatorAssignment[]
  room                 Room?                 @relation(fields: [roomId], references: [id])
  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  qrCodes              QRCode[]
  votes                Vote[]

  @@map("projects")
}

model VotingConfig {
  id              String   @id @default(cuid())
  eventId         String
  name            String
  voteType        VoteType @default("STARS")
  maxVotesPerUser Int      @default(3)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  showResults     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("voting_configs")
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  score     Int      @default(1)
  comment   String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("votes")
}

model Evaluation {
  id                  String    @id @default(cuid())
  userId              String
  projectId           String
  innovation          Int       @default(0)
  innovationComment   String?
  viability           Int       @default(0)
  viabilityComment    String?
  impact              Int       @default(0)
  impactComment       String?
  presentation        Int       @default(0)
  presentationComment String?
  scalability         Int       @default(0)
  scalabilityComment  String?
  execution           Int       @default(0)
  executionComment    String?
  totalScore          Float     @default(0)
  generalComment      String?
  status              String    @default("DRAFT")
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("evaluations")
}

model Attendance {
  id           String    @id @default(cuid())
  userId       String
  activityId   String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  points       Int       @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@map("attendances")
}

model ActivityRegistration {
  id              String   @id @default(cuid())
  userId          String
  activityId      String
  reminderSet     Boolean  @default(false)
  reminderMinutes Int?
  registeredAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@map("activity_registrations")
}

model QRCode {
  id         String    @id @default(cuid())
  code       String    @unique
  type       QRType
  userId     String?
  roomId     String?
  activityId String?
  projectId  String?
  eventId    String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  scanCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

model QRScan {
  id        String   @id @default(cuid())
  code      String
  userId    String
  scannedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([code, userId])
  @@map("qr_scans")
}

model NotificationConfig {
  id                      String   @id @default(cuid())
  eventId                 String
  activityStartEnabled    Boolean  @default(true)
  activityReminderEnabled Boolean  @default(true)
  activityReminderMinutes Int      @default(15)
  voteConfirmationEnabled Boolean  @default(true)
  voteReminderEnabled     Boolean  @default(true)
  pointsEarnedEnabled     Boolean  @default(true)
  achievementEnabled      Boolean  @default(true)
  certificateReadyEnabled Boolean  @default(true)
  announcementsEnabled    Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  event                   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("notification_configs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  eventId   String?
  title     String
  message   String
  type      NotificationType @default("INFO")
  isRead    Boolean          @default(false)
  isGlobal  Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Achievement {
  id               String            @id @default(cuid())
  name             String
  description      String
  icon             String?
  points           Int               @default(0)
  category         String?
  requirement      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  eventId     String?
  activityId  String?
  type        String
  title       String
  description String?
  issueDate   DateTime @default(now())
  pdfUrl      String?
  code        String   @unique
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model CertificateTemplate {
  id                String   @id @default(cuid())
  eventId           String?
  name              String
  type              String   @default("attendance")
  headerText        String?  @default("CERTIFICADO DE PARTICIPACIÓN")
  logoUrl           String?
  bodyText          String?  @default("Se certifica que")
  participantLabel  String?  @default("ha participado en")
  eventLabel        String?  @default("evento")
  organizationName  String?  @default("Fábrica de Ideas")
  organizationLogo  String?
  signatureText     String?
  signatureImageUrl String?
  backgroundColor   String?  @default("#ffffff")
  primaryColor      String?  @default("#059669")
  secondaryColor    String?  @default("#0d9488")
  textColor         String?  @default("#1f2937")
  fontFamily        String?  @default("Helvetica")
  borderColor       String?  @default("#059669")
  borderWidth       Int?     @default(4)
  borderRadius      Int?     @default(0)
  paperWidth        Int?     @default(297)
  paperHeight       Int?     @default(210)
  showQrCode        Boolean  @default(true)
  showCode          Boolean  @default(true)
  showDate          Boolean  @default(true)
  showActivities    Boolean  @default(true)
  isActive          Boolean  @default(true)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("certificate_templates")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  userId     String?
  eventId    String?
  entityId   String?
  entityType String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("analytics_events")
}

model AppConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_config")
}

model EvaluatorAssignment {
  id          String    @id @default(cuid())
  evaluatorId String
  projectId   String
  assignedBy  String
  status      String    @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluator   User      @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([evaluatorId, projectId])
  @@map("evaluator_assignments")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

enum UserRole {
  ADMIN
  ORGANIZER
  MODERATOR
  EVALUATOR
  PARTICIPANT
}

enum ActivityStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityType {
  KEYNOTE
  KEYNOTE_SPEECH
  CHARLA_MAGISTRAL
  WORKSHOP
  TALLER
  PANEL
  PRESENTATION
  PITCH
  NETWORKING
  BREAK
  CEREMONY
  CONFERENCIA
  MESA_REDONDA
  FORO
  SEMINARIO
  CURSO
  OTRO
  OTHER
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FINALIST
  WINNER
}

enum VoteType {
  LIKE
  STARS
  POINTS
}

enum QRType {
  ROOM
  ACTIVITY
  PROJECT
  USER
  EVENT
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ACTIVITY_START
  ACTIVITY_REMINDER
  VOTE_REMINDER
  VOTE_CONFIRMATION
  ACHIEVEMENT
  ANNOUNCEMENT
  POINTS_EARNED
  CERTIFICATE_READY
}
